{
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "name": "@camada/core",
  "description": "camada SDK core: BLK snapshot parser/matcher (v3-v5, ordered custom rules), snapshot client, event queue, redaction, trusted-proxy IP resolution",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js",
      "require": "./dist/fetch.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsup": "^8.3.5",
    "vitest": "^3.0.0",
    "@types/node": "^22.10.0"
  }
}
