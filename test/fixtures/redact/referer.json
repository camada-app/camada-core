    },
    {
      "id": "sqli-encoded-kept",
      "ticket": "ijsa",
      "referer": "https://app.test/s?q=1%27%20or%20%271%27%3D%271",
      "ref": "https://app.test/s?q=1%27%20or%20%271%27%3D%271"
    },
    {
      "id": "xss-svg-kept",
      "ticket": "ijsa",
