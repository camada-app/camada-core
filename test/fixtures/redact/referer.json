    {
      "id": "invalid-utf8-ff-kept",
      "ticket": "ijsa",
      "referer": "https://app.test/s?q=%FF",
      "ref": "https://app.test/s?q=%FF",
      "note": "decode is bytewise (Latin-1), never a UTF-8 decoder that throws or substitutes"
    },
    {
      "id": "invalid-utf8-sequence-kept",
      "ticket": "ijsa",
      "referer": "https://app.test/s?q=%C3%28",
      "ref": "https://app.test/s?q=%C3%28"
    },
    {
      "id": "hex-trailing-newline-kept",
      "ticket": "ijsa",
      "referer": "https://app.test/s?x=a1b2c3d4e5f60718293a4b5c6d7e8f90%0A",
      "ref": "https://app.test/s?x=a1b2c3d4e5f60718293a4b5c6d7e8f90%0A",
      "note": "whole-string anchors: a trailing newline does not satisfy the end anchor"
    },
    {
      "id": "ascii-only-case-fold",
      "ticket": "ijsa",
      "referer": "https://app.test/s?ſig=abc123&Key=abc123",
      "ref": "https://app.test/s?ſig=abc123&Key=abc123",
