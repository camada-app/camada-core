      "ticket": "yfc6",
      "config": "cloudflare",
      "peer": "::FFFF:127.0.0.1",
      "xff": "8.8.8.8",
      "expect": "8.8.8.8"
    },
    {
      "id": "unset-peer-v4-mapped-upper",
      "ticket": "yfc6",
      "config": "unset",
      "peer": "::FFFF:203.0.113.9",
      "xff": null,
      "expect": "203.0.113.9"
    },
    {
      "id": "loopback-peer-v6-long-form",
      "ticket": "yfc6",
      "config": "cloudflare",
      "peer": "0:0:0:0:0:0:0:1",
      "xff": "8.8.8.8",
      "expect": "8.8.8.8",
      "note": "::1 in any spelling"
    },
    {
      "id": "cf-trusted-v4-mapped-peer",
      "ticket": "yfc6",
      "config": "cloudflare",
      "peer": "::ffff:172.64.1.1",
      "xff": "198.51.100.9",
      "expect": "198.51.100.9",
      "note": "a mapped trusted peer is trusted after reduction and walks"
    },
    {
      "id": "hops2-empty-entries",
      "ticket": "0vho",
      "config": "hops2",
      "peer": "169.254.130.1",
      "xff": "198.51.100.9, , 203.0.113.66",
      "expect": "198.51.100.9",
      "note": "empty entries are dropped before counting hops"
    },
    {
      "id": "xff-only-separators",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": " , ",
      "expect": "169.254.130.1"
    },
    {
      "id": "loopback-peer-xff-only-separators",
      "ticket": "yfc6",
      "config": "cloudflare",
      "peer": "::1",
      "xff": " , ,",
      "expect": "::1"
    },
    {
      "id": "xff-empty-string",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "",
      "expect": "169.254.130.1"
    },
    {
      "id": "xff-tab-ows",
      "ticket": "0vho",
      "config": "hops2",
      "peer": "169.254.130.1",
      "xff": "198.51.100.9\t,\t203.0.113.66",
      "expect": "198.51.100.9",
      "note": "space and tab around an entry are trimmed"
    },
    {
      "id": "xff-tab-inside-entry",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "198.51.100.9\t203.0.113.66",
      "expect": "169.254.130.1",
      "note": "only a comma separates entries"
    },
    {
      "id": "xff-zone-id",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "fe80::1%eth0",
      "expect": "169.254.130.1",
      "note": "zone ids are not valid IPs"
    },
    {
      "id": "xff-zone-id-bracket-port",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "[fe80::1%25eth0]:80",
      "expect": "169.254.130.1"
    },
    {
      "id": "cf-peer-zone-id",
      "ticket": "yfc6",
      "config": "cloudflare",
      "peer": "fe80::1%eth0",
      "xff": "8.8.8.8",
      "expect": null,
      "note": "a zone-id peer is not a valid IP: null (v3)"
    },
    {
      "id": "unset-peer-zone-id",
      "ticket": "yfc6",
      "config": "unset",
      "peer": "fe80::1%eth0",
      "xff": null,
      "expect": null,
      "note": "the result is a valid IP or null in every mode (v3)"
    },
    {
      "id": "loopback-peer-xff-v6-loopback-bracket-port",
      "ticket": "yfc6",
      "config": "cloudflare",
      "peer": "127.0.0.1",
      "xff": "[::1]:80",
      "expect": "::1",
      "note": "a loopback XFF entry is ordinary and untrusted, after port strip"
    },
    {
      "id": "port-zero",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "203.0.113.66:0",
      "expect": "203.0.113.66"
    },
    {
      "id": "port-max",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "203.0.113.66:65535",
      "expect": "203.0.113.66"
    },
    {
      "id": "port-five-digits-out-of-range",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "203.0.113.66:99999",
      "expect": "203.0.113.66",
      "note": "a port is 1-5 digits; no range check"
    },
    {
      "id": "cf-peer-unix-socket",
      "ticket": "yfc6",
      "config": "cloudflare",
      "peer": "/run/app.sock",
      "xff": "8.8.8.8",
      "expect": null,
      "note": "a non-null peer that is not a valid IP gives a null result (v3); it never selects the no-peer walk"
    },
    {
      "id": "cf-peer-with-port",
      "ticket": "yfc6",
      "config": "cloudflare",
      "peer": "172.64.1.1:443",
      "xff": "8.8.8.8",
      "expect": null,
      "note": "the peer is never port-stripped; an ip:port peer is not a valid IP: null (v3)"
    },
    {
      "id": "cf-peer-empty-string",
      "ticket": "yfc6",
      "config": "cloudflare",
      "peer": "",
      "xff": "1.2.3.4, 198.51.100.9, 172.64.1.1",
      "expect": "198.51.100.9",
      "note": "an empty peer is the same as null (no-peer adapters only)"
    },
    {
      "id": "cf-peer-at-sign",
      "ticket": "yfc6",
      "config": "cloudflare",
      "peer": "@",
      "xff": "8.8.8.8",
      "expect": null,
      "note": "Go net.SplitHostPort-style junk: an invalid peer gives null, XFF is never walked"
    },
    {
      "id": "cf-peer-v4-mapped-garbage",
      "ticket": "yfc6",
      "config": "cloudflare",
      "peer": "::ffff:zz",
      "xff": "8.8.8.8",
      "expect": null
    },
    {
      "id": "cf-peer-trailing-space",
      "ticket": "yfc6",
      "config": "cloudflare",
      "peer": "172.64.1.1 ",
      "xff": "8.8.8.8",
      "expect": null,
      "note": "the peer is never trimmed"
    },
    {
      "id": "unset-peer-unix-socket",
      "ticket": "yfc6",
      "config": "unset",
      "peer": "/run/app.sock",
      "xff": null,
      "expect": null
    },
    {
      "id": "hops-invalid-peer-valid-xff",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "/run/app.sock",
      "xff": "203.0.113.66",
      "expect": "203.0.113.66",
      "note": "hops does not look at the peer"
    },
    {
      "id": "hops-invalid-peer-invalid-xff",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "/run/app.sock",
      "xff": "not-an-ip",
      "expect": null,
      "note": "fallback to an invalid peer is null"
    },
    {
      "id": "unset-peer-v6-embedded-v4",
      "ticket": "yfc6",
      "config": "unset",
      "peer": "64:ff9b::198.51.100.9",
      "xff": null,
      "expect": null,
      "note": "embedded dotted quads are not valid IPv6 here (only ::ffff:a.b.c.d is reduced)"
    },
    {
      "id": "xff-ipv6-leading-colon",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": ":8:8:8",
      "expect": "169.254.130.1",
      "note": "a single leading colon is not valid IPv6"
    },
    {
      "id": "xff-ipv6-trailing-colon",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "2001:db8::1:",
      "expect": "169.254.130.1",
      "note": "a single trailing colon is not valid IPv6"
    },
    {
      "id": "cf-xff-ipv6-trailing-colon-not-trusted",
      "ticket": "yfc6",
      "config": "cloudflare",
      "peer": "172.64.1.1",
      "xff": "198.51.100.9, 2606:4700::1:",
      "expect": "172.64.1.1",
      "note": "an invalid entry is never a trusted hop: it is the candidate, fails validation, peer wins"
    },
    {
      "id": "xff-ipv6-embedded-v4",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "::1.2.3.4",
      "expect": "169.254.130.1",
      "note": "embedded dotted quad: invalid"
    },
    {
      "id": "xff-ipv6-embedded-v4-nat64",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "64:ff9b::198.51.100.9",
      "expect": "169.254.130.1"
    },
    {
      "id": "xff-ipv6-embedded-v4-long-mapped",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "0:0:0:0:0:ffff:1.2.3.4",
      "expect": "169.254.130.1",
      "note": "only the literal ::ffff: prefix is reduced"
    },
    {
      "id": "xff-nbsp-not-trimmed",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "203.0.113.66 ",
      "expect": "169.254.130.1",
      "note": "only space and tab are trimmed"
    },
    {
      "id": "xff-nbsp-only-entry-counts",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "203.0.113.66, ",
      "expect": "169.254.130.1",
      "note": "an NBSP-only entry is not empty: it counts, fails validation, peer wins"
    },
    {
      "id": "xff-cr-not-trimmed",
      "ticket": "0vho",
      "config": "hops1",
      "peer": "169.254.130.1",
      "xff": "203.0.113.66\r",
      "expect": "169.254.130.1"
    }
  ]
}
